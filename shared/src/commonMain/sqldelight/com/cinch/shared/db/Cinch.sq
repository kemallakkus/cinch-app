-- Cinch yerel veritabanı şeması (local-first, sunucu yok).

CREATE TABLE IF NOT EXISTS card (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    currency TEXT NOT NULL DEFAULT 'TRY',
    -- Taşınan borç (kuruş) ve aylık faiz+vergi oranı (ör. 4.9)
    carried_balance_minor INTEGER NOT NULL DEFAULT 0,
    monthly_rate_percent REAL NOT NULL DEFAULT 4.9,
    statement_day INTEGER,
    -- Kart numarasının son 4 hanesi: banka ekranı fotoğrafındaki "•••• 1243" ile kart eşlenir.
    last4 TEXT,
    -- CREDIT (kredi kartı) ya da DEBIT (banka kartı: ekstre, borç, faiz yok).
    type TEXT NOT NULL DEFAULT 'CREDIT'
);

CREATE TABLE IF NOT EXISTS expense (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    date_epoch_day INTEGER NOT NULL,
    gross_minor INTEGER NOT NULL,
    chargeable_fraction REAL NOT NULL DEFAULT 1.0,
    currency TEXT NOT NULL DEFAULT 'TRY',
    category TEXT NOT NULL DEFAULT 'DIGER',
    card_id INTEGER,
    note TEXT NOT NULL DEFAULT '',
    raw_text TEXT NOT NULL DEFAULT '',
    -- Hızlı kayıttan çıkan sade kelimeler, boşlukla ayrılmış (alışkanlık analizi için).
    tokens TEXT NOT NULL DEFAULT '',
    -- Doluysa bu kayıt bir sabit giderin ödemesidir: haftalık paya sayılmaz, ay hesabına girer.
    fixed_expense_id INTEGER,
    FOREIGN KEY (card_id) REFERENCES card(id)
);

-- Kullanıcının kelime→kategori düzeltmeleri (öğrenme).
CREATE TABLE IF NOT EXISTS category_correction (
    keyword TEXT NOT NULL PRIMARY KEY,
    category TEXT NOT NULL
);

CREATE TABLE IF NOT EXISTS budget_config (
    id INTEGER PRIMARY KEY DEFAULT 1,
    weekly_limit_minor INTEGER NOT NULL,
    currency TEXT NOT NULL DEFAULT 'TRY',
    week_start_iso INTEGER NOT NULL DEFAULT 1,
    weekly_goal_minor INTEGER,
    -- Kullanılmıyor: maaş günü 1.sqm ile gelirlere taşındı. Eski kurulumlarla uyum için duruyor.
    salary_day INTEGER
);

-- Her ay ödenen sabit giderler (kira, fatura, abonelik, kredi taksiti...).
CREATE TABLE IF NOT EXISTS fixed_expense (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    amount_minor INTEGER NOT NULL,
    currency TEXT NOT NULL DEFAULT 'TRY',
    -- Ödeme günü (1–31); ay kısaysa son gün.
    day_of_month INTEGER NOT NULL,
    kind TEXT NOT NULL DEFAULT 'OTHER',
    -- Hangi kartla ödendiği; null = nakit/havale.
    card_id INTEGER,
    -- Ödeme şekli: MONTHLY (bitişi yok), INSTALLMENTS (taksitli), FLEXIBLE (esnek borç).
    plan TEXT NOT NULL DEFAULT 'MONTHLY',
    -- Taksitli: toplam taksit ve uygulamadan önce ödenmiş olanlar.
    total_installments INTEGER,
    paid_before INTEGER NOT NULL DEFAULT 0,
    -- Esnek borç: eklendiği andaki kalan borç (sonraki ödemeler bundan düşer).
    debt_minor INTEGER
);

-- Düzenli aylık gelirler (maaş, ek iş, kira geliri...).
CREATE TABLE IF NOT EXISTS income (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    amount_minor INTEGER NOT NULL,
    currency TEXT NOT NULL DEFAULT 'TRY',
    -- Ayın kaçında yattığı (1–31); ay kısaysa son gün. Null = günü belli değil.
    day_of_month INTEGER
);

-- Banka ekranından okunan ekstre bilgileri; her okuma ayrı satır (ödeme ilerlemesi ve aylık kıyas için).
-- Tutarlar kuruş; okunamayan alan NULL.
CREATE TABLE IF NOT EXISTS card_statement (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    card_id INTEGER NOT NULL,
    read_epoch_day INTEGER NOT NULL,
    statement_epoch_day INTEGER,
    due_epoch_day INTEGER,
    next_statement_epoch_day INTEGER,
    currency TEXT NOT NULL DEFAULT 'TRY',
    statement_balance_minor INTEGER,
    minimum_payment_minor INTEGER,
    period_spending_minor INTEGER,
    future_installments_minor INTEGER,
    total_debt_minor INTEGER,
    credit_limit_minor INTEGER,
    available_limit_minor INTEGER
);

-- ───────── expense ─────────
insertExpense:
INSERT INTO expense(date_epoch_day, gross_minor, chargeable_fraction, currency, category, card_id, note, raw_text, tokens, fixed_expense_id)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

lastInsertedRowId:
SELECT last_insert_rowid();

expensesBetween:
SELECT * FROM expense WHERE date_epoch_day BETWEEN :from AND :to ORDER BY date_epoch_day, id;

-- Geçmişte arama tüm kayıtlarda yapılır (Türkçe harf eşleştirmesi SQL'de değil, uygulamada).
allExpenses:
SELECT * FROM expense ORDER BY date_epoch_day, id;

expenseById:
SELECT * FROM expense WHERE id = ?;

-- Para birimi ve sabit gider bağı düzenlenmez.
updateExpense:
UPDATE expense
SET date_epoch_day = ?, gross_minor = ?, chargeable_fraction = ?, category = ?, card_id = ?,
    note = ?, raw_text = ?, tokens = ?
WHERE id = ?;

expensesForCard:
SELECT * FROM expense WHERE card_id = ? ORDER BY date_epoch_day, id;

expensesForCardBetween:
SELECT * FROM expense
WHERE card_id = :cardId AND date_epoch_day BETWEEN :from AND :to
ORDER BY date_epoch_day, id;

-- Kart silinince harcamalar kalır, nakit sayılır.
detachExpensesFromCard:
UPDATE expense SET card_id = NULL WHERE card_id = ?;

deleteExpense:
DELETE FROM expense WHERE id = ?;

-- ───────── card ─────────
insertCard:
INSERT INTO card(name, currency, carried_balance_minor, monthly_rate_percent, statement_day, last4, type)
VALUES (?, ?, ?, ?, ?, ?, ?);

allCards:
SELECT * FROM card ORDER BY id;

cardById:
SELECT * FROM card WHERE id = ?;

updateCard:
UPDATE card
SET name = ?, carried_balance_minor = ?, monthly_rate_percent = ?, statement_day = ?, last4 = ?, type = ?
WHERE id = ?;

deleteCard:
DELETE FROM card WHERE id = ?;

-- ───────── card_statement ─────────
insertStatement:
INSERT INTO card_statement(
    card_id, read_epoch_day, statement_epoch_day, due_epoch_day, next_statement_epoch_day, currency,
    statement_balance_minor, minimum_payment_minor, period_spending_minor, future_installments_minor,
    total_debt_minor, credit_limit_minor, available_limit_minor
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

-- En yeni okuma üstte.
statementsForCard:
SELECT * FROM card_statement WHERE card_id = ? ORDER BY read_epoch_day DESC, id DESC;

allStatements:
SELECT * FROM card_statement ORDER BY read_epoch_day DESC, id DESC;

deleteStatementsForCard:
DELETE FROM card_statement WHERE card_id = ?;

-- ───────── corrections ─────────
upsertCorrection:
INSERT OR REPLACE INTO category_correction(keyword, category) VALUES (?, ?);

correctionFor:
SELECT category FROM category_correction WHERE keyword = ?;

allCorrections:
SELECT * FROM category_correction;

-- ───────── budget ─────────
upsertBudget:
INSERT OR REPLACE INTO budget_config(id, weekly_limit_minor, currency, week_start_iso, weekly_goal_minor)
VALUES (1, ?, ?, ?, ?);

currentBudget:
SELECT * FROM budget_config WHERE id = 1;

-- ───────── income ─────────
allIncomes:
SELECT * FROM income ORDER BY id;

incomeById:
SELECT * FROM income WHERE id = ?;

insertIncome:
INSERT INTO income(name, amount_minor, currency, day_of_month) VALUES (?, ?, ?, ?);

updateIncome:
UPDATE income SET name = ?, amount_minor = ?, day_of_month = ? WHERE id = ?;

deleteIncome:
DELETE FROM income WHERE id = ?;

-- ───────── fixed_expense ─────────
allFixedExpenses:
SELECT * FROM fixed_expense ORDER BY day_of_month, id;

fixedExpenseById:
SELECT * FROM fixed_expense WHERE id = ?;

insertFixedExpense:
INSERT INTO fixed_expense(name, amount_minor, currency, day_of_month, kind, card_id, plan, total_installments, paid_before, debt_minor)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateFixedExpense:
UPDATE fixed_expense
SET name = ?, amount_minor = ?, day_of_month = ?, kind = ?, card_id = ?,
    plan = ?, total_installments = ?, paid_before = ?, debt_minor = ?
WHERE id = ?;

-- Tüm sabit gider ödemeleri: taksit sayısı ve kalan borç geçmiş ödemelerden hesaplanır.
allFixedPayments:
SELECT * FROM expense WHERE fixed_expense_id IS NOT NULL ORDER BY date_epoch_day, id;

deleteFixedExpense:
DELETE FROM fixed_expense WHERE id = ?;

-- ───────── yedek / geri yükleme ─────────
-- Geri yüklemede her şey silinip yedekteki satırlar kimlikleriyle yazılır (harcama → kart, sabit gider bağları korunur).

deleteAllExpenses:
DELETE FROM expense;

deleteAllCards:
DELETE FROM card;

deleteAllIncomes:
DELETE FROM income;

deleteAllFixedExpenses:
DELETE FROM fixed_expense;

deleteAllStatements:
DELETE FROM card_statement;

deleteAllCorrections:
DELETE FROM category_correction;

deleteBudget:
DELETE FROM budget_config;

restoreBudget:
INSERT INTO budget_config(id, weekly_limit_minor, currency, week_start_iso, weekly_goal_minor, salary_day)
VALUES (1, ?, ?, ?, ?, ?);

restoreCard:
INSERT INTO card(id, name, currency, carried_balance_minor, monthly_rate_percent, statement_day, last4, type)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

restoreExpense:
INSERT INTO expense(id, date_epoch_day, gross_minor, chargeable_fraction, currency, category, card_id, note, raw_text, tokens, fixed_expense_id)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

restoreIncome:
INSERT INTO income(id, name, amount_minor, currency, day_of_month) VALUES (?, ?, ?, ?, ?);

restoreFixedExpense:
INSERT INTO fixed_expense(id, name, amount_minor, currency, day_of_month, kind, card_id, plan, total_installments, paid_before, debt_minor)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

restoreStatement:
INSERT INTO card_statement(
    id, card_id, read_epoch_day, statement_epoch_day, due_epoch_day, next_statement_epoch_day, currency,
    statement_balance_minor, minimum_payment_minor, period_spending_minor, future_installments_minor,
    total_debt_minor, credit_limit_minor, available_limit_minor
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);
