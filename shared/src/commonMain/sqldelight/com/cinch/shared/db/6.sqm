-- Sürüm 6 → 7: kumbara (biriktirme hedefleri ve atılan paralar). Mevcut veriye dokunulmaz.

-- Kumbara: biriktirme hedefleri ("Tatil: 20.000 ₺") ve hedeflere atılan paralar (eksi: çekilen).
CREATE TABLE IF NOT EXISTS savings_goal (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    emoji TEXT NOT NULL DEFAULT '🐷',
    target_minor INTEGER NOT NULL,
    currency TEXT NOT NULL DEFAULT 'TRY',
    created_epoch_day INTEGER NOT NULL
);

CREATE TABLE IF NOT EXISTS savings_deposit (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    goal_id INTEGER NOT NULL,
    amount_minor INTEGER NOT NULL,
    currency TEXT NOT NULL DEFAULT 'TRY',
    date_epoch_day INTEGER NOT NULL,
    note TEXT NOT NULL DEFAULT ''
);
